APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/xabarchi
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-64-hex-chars
CORS_ORIGINS=http://localhost:5173

# Public URLs (OAuth callback / e-mail links / checkout redirects)
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Social sign-in — a provider is enabled only when its client id is set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# SMTP — empty SMTP_HOST logs mail instead of sending (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Xabarchi <no-reply@xabarchi.uz>

# Polar (polar.sh) billing — empty token disables the integration
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_BIZNES=
POLAR_PRODUCT_KORXONA=
